# Test secrets for Playwright E2E tests
# Copy to .env.test.local and fill with real values (do NOT commit .env.test.local)
TEST_JWT_SECRET=your_test_jwt_secret_min_32_chars
TEST_COOKIE_SECRET=your_test_cookie_secret_min_32_chars
TEST_DATABASE_URL=postgresql://rina_user:password@localhost:5432/rina_db
TEST_REDIS_URL=redis://localhost:6379
TEST_PASSWORD_HASH=$2a$12$...
