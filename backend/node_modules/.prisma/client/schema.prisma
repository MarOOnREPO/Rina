// This is your Prisma schema file for Project Rina.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ───────────────────────────────────────────────────────
// Hardcoded auth (maroon / rina) — DB stores profiles & settings.
model User {
  id          String   @id @default(cuid())
  username    String   @unique // 'maroon' or 'rina'
  displayName String
  avatarUrl   String?
  timezone    String   @default("UTC") // Africa/Casablanca or Europe/Moscow
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  messages        Message[]
  cycleEntries    CycleEntry[]
  moviesAdded     Movie[]
  timeCapsules    TimeCapsule[]
  scrapbookPhotos ScrapbookPhoto[]
  goals           Goal[]
  pushSubs        PushSubscription[]
}

// ─── Calendar Events ─────────────────────────────────────────────
model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime?
  type        EventType @default(SHARED)
  creator     String // 'maroon' or 'rina'
  allDay      Boolean   @default(false)
  color       String? // hex override
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startTime])
  @@index([type])
  @@index([creator])
}

enum EventType {
  WORK
  SHARED
}

// ─── Period Tracker ──────────────────────────────────────────────
model CycleEntry {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime @db.Date
  flowIntensity Int?     @db.SmallInt // 0-4 scale
  symptoms      String[] // e.g. ["cramps", "bloating"]
  temperature   Float? // basal body temp
  notes         String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

// ─── Movie Watchlist ─────────────────────────────────────────────
model Movie {
  id           String    @id @default(cuid())
  tmdbId       Int       @unique
  title        String
  overview     String?
  posterPath   String?
  backdropPath String?
  releaseDate  DateTime?
  watched      Boolean   @default(false)
  watchedAt    DateTime?
  rating       Int?      @db.SmallInt // 1-10
  addedBy      String
  createdAt    DateTime  @default(now())

  user User @relation(fields: [addedBy], references: [id], onDelete: Cascade)

  @@index([watched])
  @@index([addedBy])
}

// ─── Chat Messages ───────────────────────────────────────────────
model Message {
  id        String      @id @default(cuid())
  senderId  String
  content   String
  type      MessageType @default(TEXT)
  mediaUrl  String?
  replyToId String?
  editedAt  DateTime?
  createdAt DateTime    @default(now())

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([senderId])
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
}

// ─── Time Capsule ────────────────────────────────────────────────
model TimeCapsule {
  id            String    @id @default(cuid())
  title         String
  description   String?
  encryptedData String // AES-256 encrypted blob (base64)
  mediaType     String // 'audio' | 'video' | 'text'
  unlockAt      DateTime
  creatorId     String
  openedAt      DateTime?
  createdAt     DateTime  @default(now())

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([unlockAt])
  @@index([creatorId])
}

// ─── Visit Countdowns ────────────────────────────────────────────
model Countdown {
  id         String   @id @default(cuid())
  title      String
  targetDate DateTime
  location   String?
  imageUrl   String?
  createdAt  DateTime @default(now())

  @@index([targetDate])
}

// ─── Scrapbook Photos (3D Map) ───────────────────────────────────
model ScrapbookPhoto {
  id           String    @id @default(cuid())
  url          String // S3/MinIO presigned URL
  thumbnailUrl String?
  lat          Float?
  lng          Float?
  caption      String?
  takenAt      DateTime?
  exifData     Json? // stored as JSONB
  uploadedBy   String
  createdAt    DateTime  @default(now())

  uploader User @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([lat, lng])
  @@index([uploadedBy])
}

// ─── Financial Goals ─────────────────────────────────────────────
model Goal {
  id            String    @id @default(cuid())
  title         String
  targetAmount  Int // stored in smallest currency unit (cents)
  currentAmount Int       @default(0)
  currency      String    @default("EUR")
  deadline      DateTime?
  icon          String? // emoji or lucide icon name
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy])
}

// ─── Whiteboard Session Metadata ─────────────────────────────────
// Actual stroke data lives in Yjs; this stores session metadata.
model WhiteboardSession {
  id        String   @id @default(cuid())
  name      String
  createdBy String
  ydocState Bytes? // optional snapshot backup
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdBy])
}

// ─── Web Push Subscriptions ──────────────────────────────────────
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
