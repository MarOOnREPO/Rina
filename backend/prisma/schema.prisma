// This is your Prisma schema file for Project Rina.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ───────────────────────────────────────────────────────
// Hardcoded auth (maroon / rina) — DB stores profiles & settings.
model User {
  id          String   @id @default(cuid())
  username    String   @unique @db.VarChar(50) // 'maroon' or 'rina'
  displayName String   @db.VarChar(100)
  avatarUrl   String?
  timezone    String   @default("UTC") // Africa/Casablanca or Europe/Moscow
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  messages           Message[]
  cycleEntries       CycleEntry[]
  moviesAdded        Movie[]
  timeCapsules       TimeCapsule[]
  scrapbookPhotos    ScrapbookPhoto[]
  goals              Goal[]
  pushSubs           PushSubscription[]
  calendarEvents     CalendarEvent[]
  countdowns         Countdown[]
  whiteboardSessions WhiteboardSession[]
  notifications      Notification[]
  partnershipsA      Partnership[] @relation("UserAPartnerships")
  partnershipsB      Partnership[] @relation("UserBPartnerships")
  spotifyToken       SpotifyToken?
}

// ─── Calendar Events ─────────────────────────────────────────────
model CalendarEvent {
  id          String    @id @default(cuid())
  title       String    @db.VarChar(200)
  description String?   @db.VarChar(2000)
  startTime   DateTime
  endTime     DateTime?
  type        EventType @default(SHARED)
  creatorId   String
  allDay      Boolean   @default(false)
  color       String?   @db.VarChar(7) // hex override
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([startTime])
  @@index([type])
  @@index([creatorId])
}

enum EventType {
  WORK
  SHARED
}

// ─── Period Tracker ──────────────────────────────────────────────
model CycleEntry {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime @db.Date
  flowIntensity Int?     @db.SmallInt // 0-4 scale
  symptoms      String[] // e.g. ["cramps", "bloating"]
  temperature   Float?   // basal body temp
  notes         String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

// ─── Movie Watchlist ─────────────────────────────────────────────
model Movie {
  id           String    @id @default(cuid())
  tmdbId       Int       @unique
  title        String    @db.VarChar(300)
  overview     String?
  posterPath   String?
  backdropPath String?
  releaseDate  DateTime?
  watched      Boolean   @default(false)
  watchedAt    DateTime?
  rating       Int?      @db.SmallInt // 1-10
  addedBy      String
  createdAt    DateTime  @default(now())

  user User @relation(fields: [addedBy], references: [id], onDelete: Cascade)

  @@index([watched])
  @@index([addedBy])
}

// ─── Chat Messages ───────────────────────────────────────────────
model Message {
  id        String      @id @default(cuid())
  senderId  String
  content   String      @db.VarChar(4000)
  type      MessageType @default(TEXT)
  mediaUrl  String?
  replyToId String?
  editedAt  DateTime?
  createdAt DateTime    @default(now())

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies Message[] @relation("MessageReplies")

  @@index([createdAt])
  @@index([senderId])
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
}

// ─── Time Capsule ────────────────────────────────────────────────
model TimeCapsule {
  id            String   @id @default(cuid())
  title         String   @db.VarChar(200)
  description   String?  @db.VarChar(2000)
  encryptedData String   // AES-256 encrypted blob (base64)
  mediaType     String   @db.VarChar(20) // 'audio' | 'video' | 'text'
  unlockAt      DateTime
  creatorId     String
  openedAt      DateTime?
  createdAt     DateTime @default(now())

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([unlockAt])
  @@index([creatorId])
}

// ─── Visit Countdowns ────────────────────────────────────────────
model Countdown {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(200)
  targetDate DateTime
  location  String?  @db.VarChar(200)
  imageUrl  String?
  createdBy String
  createdAt DateTime @default(now())

  creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([targetDate])
  @@index([createdBy])
}

// ─── Scrapbook Photos (3D Map) ───────────────────────────────────
model ScrapbookPhoto {
  id           String  @id @default(cuid())
  s3Key        String  @db.VarChar(500) // S3/MinIO object key
  thumbnailUrl String?
  lat          Float?
  lng          Float?
  caption      String? @db.VarChar(500)
  takenAt      DateTime?
  exifData     Json?   // stored as JSONB
  uploadedBy   String
  createdAt    DateTime @default(now())

  uploader User @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([lat, lng])
  @@index([uploadedBy])
}

// ─── Financial Goals ─────────────────────────────────────────────
model Goal {
  id            String   @id @default(cuid())
  title         String   @db.VarChar(200)
  targetAmount  Int      // stored in smallest currency unit (cents)
  currentAmount Int      @default(0)
  currency      String   @default("EUR") @db.VarChar(3)
  deadline      DateTime?
  icon          String?  @db.VarChar(50) // emoji or lucide icon name
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy])
}

// ─── Whiteboard Session Metadata ─────────────────────────────────
// Actual stroke data lives in Yjs; this stores session metadata.
model WhiteboardSession {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(200)
  createdBy String
  ydocState Bytes?   // optional snapshot backup
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy])
}

// ─── Partnerships ────────────────────────────────────────────────
model Partnership {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA User @relation("UserAPartnerships", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("UserBPartnerships", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

// ─── Notifications (Offline Nudge Queue + Summary) ───────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @db.VarChar(50) // 'nudge', 'summary', etc.
  title     String   @db.VarChar(200)
  body      String   @db.VarChar(500)
  data      Json?    // extra payload
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

// ─── Spotify OAuth Tokens ────────────────────────────────────────
model SpotifyToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String   @db.VarChar(500)
  refreshToken String   @db.VarChar(500)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Web Push Subscriptions ──────────────────────────────────────
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
