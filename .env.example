# ─────────────────────────────────────────────────────────────────
# Project Rina — Environment Configuration
# Copy this file to .env and fill in ALL values before deploying.
# ─────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_this_to_a_secure_random_string_64_chars_long

# ─── JWT Authentication ──────────────────────────────────────────
# Generate: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=rina_super_secret_key_maroon_loves_rina_2026_change_me_now

# ─── MinIO / S3-Compatible Storage ───────────────────────────────
MINIO_ACCESS_KEY=rina_access_key_32chars_change_me
MINIO_SECRET_KEY=rina_secret_key_64chars_change_me_immediately

# ─── TMDB API ────────────────────────────────────────────────────
# Get free API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ─── Mapbox (Frontend Build Variable) ────────────────────────────
# Add to frontend/.env.local for dev, or pass as build arg in production
# VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# ─── Web Push VAPID Keys ─────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# ─── Application ─────────────────────────────────────────────────
NODE_ENV=production
