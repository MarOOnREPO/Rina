# ─────────────────────────────────────────────────────────────────
# Project Rina — Environment Configuration
# Copy this file to .env and fill in ALL values before deploying.
# WARNING: Never commit .env to version control. Keep file permissions at 600.
# ─────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────
POSTGRES_PASSWORD=GENERATE_WITH: openssl rand -hex 32

# ─── JWT Authentication ──────────────────────────────────────────
# Generate: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING

# ─── Cookie Signing (MUST be different from JWT_SECRET) ──────────
# Generate: openssl rand -base64 64 | tr -d '\n'
COOKIE_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_STRING

# ─── CORS Origin (required in production) ────────────────────────
# Example: https://rina.example.com
CORS_ORIGIN=

# ─── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── MinIO / S3-Compatible Storage ───────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=GENERATE_WITH: openssl rand -hex 16
MINIO_SECRET_KEY=GENERATE_WITH: openssl rand -hex 32
S3_BUCKET_NAME=rina-uploads
AWS_REGION=us-east-1

# ─── TMDB API ────────────────────────────────────────────────────
# Get free API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ─── Mapbox (Frontend Build Variable) ────────────────────────────
# Add to frontend/.env.local for dev, or pass as build arg in production
# VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# ─── Web Push VAPID Keys ─────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# ─── Coturn TURN Server (WebRTC) ─────────────────────────────────
# For AWS Lightsail, deploy Coturn on a separate instance.
# For local dev, uncomment the coturn service in docker-compose.yml.
COTURN_REALM=your-domain.com
COTURN_SECRET=GENERATE_WITH: openssl rand -hex 32

# ─── Application ─────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
