# ─────────────────────────────────────────────────────────────────
# Project Rina — Environment Configuration
# Copy this file to .env and fill in ALL values before deploying.
# WARNING: Never commit .env to version control. Keep file permissions at 600.
# ─────────────────────────────────────────────────────────────────

# ─── Domain ──────────────────────────────────────────────────────
# Your public domain name (used for SSL and CORS)
DOMAIN=your-domain.com

# ─── Database ────────────────────────────────────────────────────
# Prisma connection string (built automatically in Docker from POSTGRES_PASSWORD)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://rina_user:<POSTGRES_PASSWORD>@postgres:5432/rina_db
POSTGRES_PASSWORD=<GENERATE_WITH_OPENSSL_RAND_HEX_32>

# ─── JWT Authentication ──────────────────────────────────────────
# Generate: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING

# ─── Cookie Signing (MUST be different from JWT_SECRET) ──────────
# Generate: openssl rand -base64 64 | tr -d '\n'
COOKIE_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_STRING

# ─── CORS Origin (required in production) ────────────────────────
# Example: https://rina.example.com
CORS_ORIGIN=https://your-domain.com

# ─── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── AWS S3 Storage ──────────────────────────────────────────────
# Create an S3 bucket and IAM user with s3:PutObject, s3:GetObject, s3:DeleteObject
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=rina-uploads

# ─── Auth Password Hashes ────────────────────────────────────────
# Generate bcrypt hashes for the two users (cost factor 12):
# node -e "require('bcryptjs').hash('your_password', 12).then(console.log)"
MAROON_PASSWORD_HASH=$2a$12$...
RINA_PASSWORD_HASH=$2a$12$...

# ─── YouTube Sync ────────────────────────────────────────────────
# Optional Invidious instance for YouTube search (default: vid.puffyan.us)
YOUTUBE_INVIOUS_INSTANCE=vid.puffyan.us

# ─── TMDB API ────────────────────────────────────────────────────
# Get free API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ─── Mapbox (Frontend Build Variable) ────────────────────────────
# Add to frontend/.env.local for dev, or pass as build arg in production
# VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# ─── Web Push VAPID Keys ─────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# ─── Coturn TURN Server (WebRTC) ─────────────────────────────────
# For AWS Lightsail, deploy Coturn on a separate instance.
# For local dev, uncomment the coturn service in docker-compose.yml.
COTURN_REALM=your-domain.com
COTURN_SECRET=<GENERATE_WITH_OPENSSL_RAND_HEX_32>

# ─── Backup Encryption ───────────────────────────────────────────
# Backup encryption key (generate with: openssl rand -base64 32)
BACKUP_ENCRYPTION_KEY=

# ─── Application ─────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Production domain (change this)
FRONTEND_URL=https://your-domain.com
