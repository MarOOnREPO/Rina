# =============================================================================
# Project Rina — Coturn TURN-over-TLS Configuration
# =============================================================================
# Enforces TLS-only relay communication on internal port 5349.
# Nginx Stream multiplexes public port 443 -> coturn:5349 based on SNI.
# =============================================================================

# ── Listeners — TLS ONLY ───────────────────────────────────────
no-udp
no-tcp
no-udp-relay

tls-listening-port=5349
listening-ip=0.0.0.0

# ── TLS Termination (Let's Encrypt) ────────────────────────────
# NOTE: If using a single multi-domain cert, update these paths.
cert=/etc/letsencrypt/live/turn.devopsya.com/fullchain.pem
pkey=/etc/letsencrypt/live/turn.devopsya.com/privkey.pem

# Modern cipher suite (TLS 1.2+)
cipher-list="ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384"
tls-version=1.2

# ── Relay & Network ────────────────────────────────────────────
external-ip=${EXTERNAL_IP}
min-port=49152
max-port=65535
relay-threads=2
mobility

# ── Authentication (Shared Secret / HMAC-SHA1) ─────────────────
realm=turn.devopsya.com
use-auth-secret
static-auth-secret=${COTURN_SECRET}

# ── Security Hardening ─────────────────────────────────────────
no-cli
fingerprint
no-multicast-peers
total-quota=100
user-quota=10

# ── Logging ────────────────────────────────────────────────────
verbose
pidfile=/var/tmp/turnserver.pid
